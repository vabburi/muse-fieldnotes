MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
BASETEN_API_KEY=
VERIFIER_MODEL_ID=meta-models/muse-spark-open-1026
# Order the verifier tries hosts in (default baseten,fireworks,modal).
# VERIFIER_HOSTS=modal,baseten,fireworks
# Muse Spark Open on Fireworks: the verifier's first fallback.
FIREWORKS_API_KEY=
# Muse Spark Open on a Modal Shared Endpoint: the second fallback. The token comes from
# `modal workspace proxy-tokens create`; the model id is the endpoint's host name, which
# `node --env-file=.env scripts/spark-open-hello.mjs modal` lists.
MODAL_MODEL_ID=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Shared storage for agent runs and caches when deployed: the project's Upstash Redis
# (KV_REST_API_URL / KV_REST_API_TOKEN, set on Vercel by `vercel integration add upstash`).
# Locally, runs and caches are files under .cache/; the deployed database is never used.

# Demo passcode: anyone can read jobs and notes, but running the agent, answering, signing off,
# re-checking a line and computing a new highlight need it. Required when deployed (without it
# those are refused); leave empty locally to skip it.
DEMO_PASSCODE=
